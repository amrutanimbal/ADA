#include<stdio.h>

int main()
{
    int n, i, mobile, pos, temp;
    int a[10], dir[10];
    printf("Enter n:");
    scanf("%d", &n);

    for(i=0; i<n; i++)
    {
        a[i]=i+1;
        dir[i]=-1;
    }

    while(1)
    {
        for(i=0; i<n; i++)
            printf("%d", a[i]);
        printf("\n");

        mobile=0;
        pos=-1;

        for(i=0; i<n; i++){
            if(dir[a[i]-1]==-1 && i>0 && a[i]>a[i-1] && a[i]>mobile){
                mobile=a[i];
                pos=i;
            }
            if(dir[a[i]-1]==-1 && i<n && a[i]>a[i+1] && a[i]>mobile){
                mobile=a[i];
                pos=i;
            }
        }

        if(mobile==0)
            break;

        if(dir[mobile-1]==-1){
            temp=a[pos];
            a[pos]=a[pos-1];
            a[pos-1]=temp;
            pos--;
        }
        else{
            temp=a[pos];
            a[pos]=a[pos+1];
            a[pos+1]=temp;
            pos++;
        }

        for(i=0; i<n; i++){
            if(a[i]>mobile)
                dir[a[i]-1]=-dir[a[i]-1];
        }
    }
    return 0;
}
