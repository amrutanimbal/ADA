#include<stdio.h>

int x[50];
float w[50], p[50], ratio[50];

void knapsack( int m, int n)
{
    int rem_cap;
    float P=0.0;
    for(int i=0; i<n; i++)
        x[i]=0;
    rem_cap = m;

    for(int i=0; i<n; i++)
    {
        if(w[i]<=rem_cap)
        {
            x[i]=1;
            rem_cap -= w[i];
            P += p[i];
        }
        else
        {
            x[i] = rem_cap / w[i];
            P += x[i]*p[i];
            break;
        }
    }

    printf("The total Profit is %.2f\n.", P);
}

int main()
{
    int n, m, i, j;

    printf("Enter number of items:");
    scanf("%d", &n);
    printf("Enter weight and profit of each items:");

    for(i=0; i<n; i++)
    {
        scanf("%f %f", &w[i], &p[i]);
        ratio[i] = p[i]/w[i];
    }
    printf("Enter Maximum Capacity:");
    scanf("%d", &m);

    for(i=0; i<n-1; i++)
    {
        for(j=i+1; j<n; j++)
        {
            if(ratio[i] < ratio[j])
            {
                float temp = ratio[i];
                ratio[i]=ratio[j];
                ratio[j]=temp;

                temp = w[i];
                w[i]=w[j];
                w[j]=temp;

                temp = p[i];
                p[i]=p[j];
                p[j]=temp;
            }
        }
    }

    knapsack(m, n);

    return 0;
}
